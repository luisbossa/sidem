<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- interceptorEnabled="false": iisnode ejecuta app.js directamente con node.exe.
         Es necesario porque el proyecto usa módulos ES ("type": "module" en package.json).
         enableXFF="true": envía la IP real del cliente a Node en X-Forwarded-For. -->
    <iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
             interceptorEnabled="false"
             enableXFF="true"
             loggingEnabled="false"
             watchedFiles="web.config;*.js;server\**\*.js;server\**\*.ejs" />

    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Todo pasa por Node: Express sirve las páginas, la API y los archivos de public/.
             Sin excepción para archivos existentes, para que IIS nunca entregue
             directamente la base de datos (data/), el código (server/) ni package.json. -->
        <rule name="SIDEM" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Segunda barrera: carpetas que nunca deben ser accesibles desde el navegador.
         Ojo: un segmento oculto bloquea ese nombre en CUALQUIER nivel de la URL,
         por eso no se agrega "data" (bloquearía /js/data/systems.js). -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Deja pasar las páginas de error que genera la app (404, 500…) sin reemplazarlas -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
