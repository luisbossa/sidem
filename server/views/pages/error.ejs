<%# Página de error (layout: layouts/auth, sin script). Recibe: estado, mensaje %>
<main class="login-layout">
  <%- include('../partials/login/brand-panel') %>

  <section class="login-form-area" aria-labelledby="tituloError">
    <div class="login-form-box">
      <p class="error-code">Error <%= estado %></p>
      <h1 id="tituloError"><%= tituloPagina %></h1>
      <p class="login-sub"><%= mensaje %></p>
      <a class="btn btn-blue btn-block login-submit" href="/">Volver al inicio</a>
    </div>

    <p class="login-legal">Uso exclusivo del personal de Ingeniería y Mantenimiento · CCSS</p>
  </section>
</main>
