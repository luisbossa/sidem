<%# Detalle de un indicador del dashboard (features/dashboard/details.js) %>
<div id="modalDashboardDetalle" class="modal-backdrop hidden" data-backdrop-action="close-dashboard-detail">
  <section class="modal modal-dashboard" role="dialog" aria-modal="true" aria-labelledby="modalDashboardTitulo">
    <header class="modal-header">
      <h3 id="modalDashboardTitulo" class="modal-title">Detalle del indicador</h3>
      <button type="button" class="modal-close" aria-label="Cerrar" data-action="close-dashboard-detail"><%- icono('cerrar') %></button>
    </header>
    <div id="modalDashboardContenido" class="modal-body"></div>
  </section>
</div>
