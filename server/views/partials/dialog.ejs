<%# Diálogo de alerta / confirmación que controla public/js/ui/dialogs.js %>
<div id="modalDialogo" class="modal-backdrop hidden">
  <section id="cajaDialogo" class="dialog-box warning" role="alertdialog" aria-modal="true" aria-labelledby="dialogoTitulo" aria-describedby="dialogoMensaje">
    <div id="dialogoIcono" class="dialog-icon" aria-hidden="true"></div>
    <h3 id="dialogoTitulo"></h3>
    <div id="dialogoMensaje" class="dialog-message"></div>
    <footer id="dialogoBotones" class="dialog-actions"></footer>
  </section>
</div>
